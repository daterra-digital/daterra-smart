# DATERRA Smart - SaaS Suite Agrícola 1.0
# Copie este ficheiro para .env para configurar as chaves de API locais

# Agromonitoring OpenWeather API Key (https://agromonitoring.com/)
VITE_AGROMONITORING_KEY=sua_chave_agromonitoring_aqui

# Moodle REST API Endpoint para a Academia DATERRA
VITE_MOODLE_API_URL=https://academia.daterra.pt/webservice/rest/server.php

# Supabase — valores reais apenas no ficheiro .env.local
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here