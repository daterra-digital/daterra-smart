# ==============================================================================
# DATERRA Smart — SaaS Suite Agrícola 1.0
# Modelo de Variáveis de Ambiente (.env.example)
# Copie este ficheiro para .env.local para desenvolvimento local
# ==============================================================================

# ==============================================================================
# Supabase (Chaves Públicas do Frontend)
# Obter em: https://supabase.com/dashboard/project/_/settings/api
# ==============================================================================
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# ==============================================================================
# Cloudflare Turnstile (Chave Pública do Frontend)
# Obter em: https://dash.cloudflare.com/
# ==============================================================================
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAExxxxxxxxxx

# ==============================================================================
# Google Analytics 4
# Obter em: https://analytics.google.com/
# ==============================================================================
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ==============================================================================
# Integrações Opcionais de Campo
# ==============================================================================

# Agromonitoring OpenWeather API Key
# Obter em: https://agromonitoring.com/
VITE_AGROMONITORING_KEY=sua_chave_agromonitoring_aqui

# Moodle REST API Endpoint para a Academia DATERRA
VITE_MOODLE_API_URL=https://academia.daterra.pt/webservice/rest/server.php

# ==============================================================================
# NOTAS DE SEGURANÇA IMPORTANTES:
# ==============================================================================
# 1. NUNCA coloque este ficheiro .env.example no Git com valores reais.
# 2. Para desenvolvimento local, copie para .env.local e preencha com valores reais.
# 3. O ficheiro .env.local está no .gitignore e NUNCA deve ser comitado.
# 4. As chaves privadas (BREVO_API_KEY, SUPABASE_SERVICE_ROLE_KEY, etc.)
#    são configuradas EXCLUSIVAMENTE no painel do Supabase em:
#    Project Settings > Edge Functions > Secrets
# 5. Para GitHub Pages, configure as variáveis VITE_* em:
#    GitHub Repository > Settings > Secrets and variables > Actions
# ==============================================================================